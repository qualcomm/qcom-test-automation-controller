    "platform_id": 93,
    "platform_type": "PSOC",
    "reset_enabled": false,
    "script": "def powerOff() \nlogComment ====== powerOffTheDevice sequence start ======\n \nbattery 1\n \nlogComment ====== powerOffTheDevice sequence finish ======\n \n \ndef powerOn()\nlogComment ====== powerOnTheDevice sequence start ======\n \nbattery 0\n \nlogComment ====== powerOnTheDevice sequence finish ======\n \n \ndef reset()\nlogComment ====== reset start ======\n \npowerOff\ndelay 1500\npowerOn\n \nlogComment ====== reset finish ======\n \n \ndef bootToEDL()\nlogComment ====== s1_md_sail_edl start ======\n \npowerOff\npedl 1\n                          sedl 1\ndelay 1500\npowerOn\ndelay 5000\ndelay $Optional_GPIO_Hold_Time\npedl 0\n                          sedl 0\n \nlogComment ======  s1_md_sail_edl finish ======\n \n \ndef bootToSecondaryEDL()\nlogComment ====== s1_sail_edl start ======\n \npowerOff\n                          sedl 1\ndelay 1500\npowerOn\ndelay 5000\ndelay $Optional_GPIO_Hold_Time\n                          sedl 0\n \nlogComment ======  s1_sail_edl finish ======\n \n \ndef bootToUEFI()\nlogComment ====== s1_uefi start ======\n \nreset\n                          pkey 0\nuefi 1\npkey 1\ndelay 8000\ndelay $Optional_GPIO_Hold_Time\npkey 0\n                          uefi 0\n \nlogComment ======s1_uefi finish ======\n \n \ndef bootToFastboot()\nlogComment ====== s1_fastboot start ======\n \npowerOff\n                          delay 1500\nfastboot 1\ndelay 500\npowerOn\ndelay 8000\ndelay $Optional_GPIO_Hold_Time\nfastboot 0\n \nlogComment ====== s1_fastboot finish ======",
    "supportedFirmwareVer": [
        15,
        18,
        19
    ],
